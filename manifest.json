{
  "manifest_version": 2,
  "name": "PauseSpring",
  "version": "1.0",
  "description": "Auto-pauses videos when you switch tabs/windows or type, resumes on return. Choose: Both, Tab only, or Window only.",
  "homepage_url": "https://github.com/projectsbyayush/pause-spring",
  "author": "projectsbyayush",

  "browser_specific_settings": {
    "gecko": {
      "id": "pausespring@projectsbyayush",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": ["tabs", "storage", "<all_urls>"],

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "browser_action": {
    "default_title": "PauseSpring",
    "default_popup": "popup.html",
    "default_icon": "icons/icon-48.png"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
